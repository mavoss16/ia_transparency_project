# Claude Code local settings (machine-specific)
.claude/settings.local.json

# RStudio / R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# renv
renv/library/
renv/staging/

# Quarto local render artifacts under site/ (docs/ is the published GH Pages output and IS tracked)
site/**/*.html
site/**/*_files/
site/.quarto/
/.quarto/
**/*.quarto_ipynb

# Logs
logs/

# Campaign finance: raw source + large derived files not committed (see CLAUDE.md)
data/campaign_finance/source/
data/campaign_finance/processed/
data/campaign_finance/*.duckdb

# Legislature: floor-vote and journal PDFs read only by archive/old_pipeline/
# (LegiScan roll calls replaced them). Kept on disk, not in the checkout.
data/legislature/archive/Floor Votes/
data/legislature/archive/Journals/

# Elections: raw downloaded data (shapefiles, precinct results) — reproducible via download scripts
data/elections/raw/

# Impeccable design skill: installed locally per machine, not project code
# (its critique snapshots in .impeccable/critique/ ARE tracked)
.claude/skills/impeccable/
.claude/agents/impeccable-*
.github/skills/impeccable/
.github/agents/impeccable-*
